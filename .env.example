# Copy this file to .env for local use. npm run dev and npm start load it.
# Restart the application after changing .env.
# Do not commit .env or paste real API keys into this example file.

# Keep port 3001 when using the default Vite development proxy.
PORT=3001

# Local persistent storage. On Railway, use DATA_DIR=/data with a /data volume.
DATA_DIR=./data

# Optional: automatic address search and driving distances.
# Obtain your own Standard API key at https://account.heigit.org/.
# Without a key, challenges and manual distances still work.
ORS_API_KEY=

# Optional: public URL used by printed QR codes, e.g. https://shipments.example.com
# Leave blank locally to use the domain where labels are opened.
APP_URL=

# Optional: first-installation setup code. Leave unset locally to generate
# data/setup-token.txt automatically. On Railway, configure a long random
# SETUP_TOKEN in service Variables before the first deployment, then remove it.
# SETUP_TOKEN=

# Set NODE_ENV=production only when serving the app over HTTPS.
# Production login cookies require HTTPS.
# NODE_ENV=production
